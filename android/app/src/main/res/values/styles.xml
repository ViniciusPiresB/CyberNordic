<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/azul_forte</item>
        <item name="colorAccent">@color/azul_borda</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/azul_claro</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Botao" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/azul_forte</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
